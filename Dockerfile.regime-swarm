# Regime Drift 9-Agent Schwarm — production daemon (monitoring only, no order send)
#
# Build:
#   docker build -f Dockerfile.regime-swarm -t agentx-regime-swarm .
#
# Run:
#   docker compose -f docker-compose.regime-swarm.yml up

FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    tzdata \
    && rm -rf /var/lib/apt/lists/*

# gate_core (A0/A2.5) → kanten_ledger → emergence/__init__ → measure (numpy)
RUN pip install --no-cache-dir 'numpy>=1.26.0'

COPY services/__init__.py ./services/
COPY services/fail_closed_gate/ ./services/fail_closed_gate/
COPY agents_b2g/__init__.py ./agents_b2g/
COPY agents_b2g/emergence/ ./agents_b2g/emergence/
# P3 AstroCore hook (read-only Class-C; worm/neo4j/synthetic — no order send)
COPY agents_b2g/astrocore_hook/ ./agents_b2g/astrocore_hook/
COPY imports/cherrystudio/astrocore/test_liquidation_coupling.py \
     imports/cherrystudio/astrocore/astrocore_coupling.py \
     imports/cherrystudio/astrocore/neo4j_reader.py \
     imports/cherrystudio/astrocore/raas_ingest.py \
     ./imports/cherrystudio/astrocore/
COPY prototypes/raas_paper_trading/ ./prototypes/raas_paper_trading/
COPY scripts/run_regime_swarm_daemon.py ./scripts/
COPY scripts/run_regime_swarm_infra_smoke.py ./scripts/
COPY scripts/recover_regime_swarm_rt_abort.py ./scripts/
COPY scripts/helm_pod_smoke.py ./scripts/
COPY scripts/helm_astrocore_hook_smoke.py ./scripts/
COPY scripts/raas_hourly_rt_check.py ./scripts/
COPY scripts/raas_alert.py ./scripts/
COPY scripts/telegram_alert.py ./scripts/
COPY config/regime_swarm.json ./config/

RUN mkdir -p /data/audit /data/state /data/reports /data/worm/paper_runs /data/worm/live

# Import smoke — fails build if hook modules missing
RUN python3 -c "\
from agents_b2g.astrocore_hook import AstrocoreHookClient, parse_gap_logs; \
from pathlib import Path; \
print('astrocore_hook import ok')"

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    TZ=UTC \
    SWARM_ENV=production \
    SWARM_DATA_ROOT=/data \
    SWARM_CONFIG=/app/config/regime_swarm.json \
    PYTHONPATH=/app

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD test -f /tmp/swarm_heartbeat && find /tmp/swarm_heartbeat -mmin -2 | grep -q . || exit 1

EXPOSE 8080

ENTRYPOINT ["python3", "scripts/run_regime_swarm_daemon.py"]
