# Regime Drift 9-Agent Schwarm — production daemon (monitoring only, no order send)
#
# Build:
#   docker build -f Dockerfile.regime-swarm -t agentx-regime-swarm .
#
# Run:
#   docker compose -f docker-compose.regime-swarm.yml up

FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    tzdata \
    && rm -rf /var/lib/apt/lists/*

COPY prototypes/raas_paper_trading/ ./prototypes/raas_paper_trading/
COPY scripts/run_regime_swarm_daemon.py ./scripts/
COPY config/regime_swarm.json ./config/

RUN mkdir -p /data/audit /data/state /data/reports /data/worm/paper_runs

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    TZ=UTC \
    SWARM_ENV=production \
    SWARM_DATA_ROOT=/data \
    SWARM_CONFIG=/app/config/regime_swarm.json \
    PYTHONPATH=/app

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD test -f /tmp/swarm_heartbeat && find /tmp/swarm_heartbeat -mmin -2 | grep -q . || exit 1

EXPOSE 8080

ENTRYPOINT ["python3", "scripts/run_regime_swarm_daemon.py"]
