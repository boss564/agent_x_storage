  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Ingest Throughput (events/s)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "palette-classic" } },
        "overrides": []
      },
      "options": {
        "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        { "expr": "rate(total_processed_events[5s])", "legendFormat": "Surface events/s", "refId": "A" },
        { "expr": "rate(total_events[5s])", "legendFormat": "Subsurface (D01) events/s", "refId": "B" }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "P99 Clearance (SLA: 2ms = 2000µs)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "µs",
          "color": { "mode": "palette-classic" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 2000 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        { "expr": "latency_p99_us", "legendFormat": "Surface P99 (µs)", "refId": "A" },
        { "expr": "clearance_p99_ms * 1000", "legendFormat": "Infantry clearance P99 (µs)", "refId": "B" }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Darkpool & L1 Settlement",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "palette-classic" } },
        "overrides": []
      },
      "options": {
        "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        { "expr": "l1_settled_events_total", "legendFormat": "L1 Settled (total)", "refId": "A" },
        { "expr": "quarantined_total", "legendFormat": "Quarantined (poison)", "refId": "B" },
        { "expr": "l1_anchors", "legendFormat": "L1 Anchors (epochs)", "refId": "C" }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Panzergrenadier Dismount (Edge Clearance)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "palette-classic" } },
        "overrides": []
      },
      "options": {
        "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom" },
