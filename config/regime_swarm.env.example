# Regime swarm production daemon — copy to regime_swarm.env (do not commit secrets)
#   cp config/regime_swarm.env.example config/regime_swarm.env

# Cycle interval (seconds)
CYCLE_INTERVAL_SECONDS=60

# Data root inside container (audit/state/worm mounts)
SWARM_DATA_ROOT=/data

# Optional overrides
# SWARM_CONFIG=/app/config/regime_swarm.json
# SWARM_SEED=42
# SWARM_METRICS_ENABLED=true
# SWARM_METRICS_PORT=8080

# AstroCore Class-C hook (P3) — see docs/ASTROCORE_HOOK_DEPLOY.md
# ASTROCORE_HOOK_ENABLED=false
# ASTROCORE_DATA_SOURCE=worm
# RAAS_AUDIT_DIR=/data/audit
# ASTROCORE_NEO4J_LOOKBACK_DAYS=7
# ASTROCORE_FUNDING_PERIOD_S=28800

# Alerting (leave empty to disable)
SLACK_WEBHOOK_URL=
PAGERDUTY_INTEGRATION_KEY=

# Paper WORM ingest is separate (raas-paper-collect); mount host logs here:
#   ./logs/worm/paper_runs:/data/worm/paper_runs:ro
