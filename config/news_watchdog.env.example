# News watchdog host overrides (copy to config/news_watchdog.env or let phase1-m2-install manage it).
#
# WATCHDOG_M2_MONITOR=auto  — check only after first m2_live_monitor.jsonl exists (dev default)
# WATCHDOG_M2_MONITOR=1     — always check; MISSING/STALE → CRITICAL (Hetzner after phase1 install)
# WATCHDOG_M2_MONITOR=0     — disable instance-7 check
#
# WATCHDOG_CRON_INTERVAL_MINUTES=60   # 5-min Polling-Epoche: set to 5 (G1 A3: n_min=244)
# NEWS_SCHEDULER_INTERVAL_MINUTES=60    # fallback only if schedule unreadable; status WARN if != crontab
# M2_LIVE_MONITOR_AUDIT_JSONL=data/m2_live_monitor.jsonl

WATCHDOG_M2_MONITOR=auto
