# RaaS ops automation — copy to raas_ops.env (do not commit secrets)
#   cp config/raas_ops.env.example config/raas_ops.env

# Optional: absolute repo root (cron/systemd). Empty = script discovers via cwd.
RAAS_REPO_ROOT=

# Telegram (leave empty to disable)
RAAS_TELEGRAM_BOT_TOKEN=
RAAS_TELEGRAM_CHAT_ID=

# Discord webhook (leave empty to disable)
RAAS_DISCORD_WEBHOOK_URL=

# Notify: max blocks per message
RAAS_NOTIFY_MAX_BLOCKS=5
