# Telemetry-Bridge — Umgebung fuer den Hetzner-Host
#
# Verwendung (systemd): /etc/agent-x/telemetry-bridge.env
#   sudo install -m 0644 telemetry-bridge.env /etc/agent-x/telemetry-bridge.env
#
# KEINE SECRETS IN DIESER DATEI. Sie enthaelt ausschliesslich Pfade und Takte.
# Die status.json wird per rsync auf den Mac geholt und landet dort im
# Browser-Kontext — was hier hineinfliesst, ist potenziell oeffentlich.

# --- Wo die Bridge liegt -------------------------------------------------
# Absoluter Pfad zur Bridge-Datei (identisch zum lokalen Skript, per rsync
# verteilt — EIN Code-Pfad, keine Gabelung).
# HINWEIS: Diese Variable wird NICHT von Python gelesen, sondern nur von der
# systemd-Unit expandiert. Sie steht hier als Dokumentation des Deploy-Ziels.
BRIDGE_SCRIPT=/opt/agent-x/telemetry_bridge.py

# --- Registry ------------------------------------------------------------
# Bestimmt, WELCHE Repos und Prozesse geprueft werden. Auf dem Mac sind das
# andere als hier — deshalb eine eigene Datei statt Codeaenderung.
AGENTX_TELEMETRY_REGISTRY=/etc/agent-x/telemetry-registry.json

# --- Schreibziel ---------------------------------------------------------
# Die einzige Schnittstelle nach aussen. Der Pull-Agent holt genau diese Datei.
# /var/lib statt /tmp: tmpfs haelt nicht ueber Reboot, und der Pull-Agent
# braucht eine stabile Quelle.
AGENTX_TELEMETRY_OUT=/var/lib/agent-x-telemetry/status.json

# --- Log-Tail ------------------------------------------------------------
# WARNUNG: Diese Datei wird ausschliesslich gelesen — die Bridge scannt KEINE
# Verzeichnisse. Trotzdem gilt: nur Logs mit oeffentlichem Charakter zeigen.
# Nicht auf settings.env / .env / *.secret zeigen — die status.json wandert
# ueber SSH und erscheint im Dashboard.
AGENTX_TELEMETRY_LOG=/root/agent_x_storage/logs/audit/news_cron.log

# --- Takt ----------------------------------------------------------------
# Sekunden zwischen zwei Snapshots. Auf dem Host ist der Rhythmus entspannter
# als lokal: die Remote-Werte aendern sich selten (Git-HEAD, Prozess-Uptime).
# Der Pull-Agent auf dem Mac pollt ohnehin nur alle 15s — ein 2s-Takt hier
# wuerde 30x dieselbe Datei schreiben.
AGENTX_TELEMETRY_INTERVAL=5

# --- Optional: HTTP-Endpoint ---------------------------------------------
# Standardmaessig AUS. Nie auf 0.0.0.0 binden ohne TLS/Firewall — der Host ist
# oeffentlich erreichbar, und /status.json enthaelt Repo-Pfade und Prozess-PIDs.
# Fuer den Pull-Agenten nicht noetig (er liest die Datei per rsync).
# AGENTX_TELEMETRY_SERVE=0
# AGENTX_TELEMETRY_HOST=127.0.0.1
# AGENTX_TELEMETRY_PORT=8787

# --- Host-Kennzeichnung --------------------------------------------------
# Erscheint als meta.host im Snapshot. Beim SSH-Aufruf ist der Hostname des
# Remote-Rechners nur eine Nummer — im Dashboard soll "hetzner" stehen.
# ACHTUNG: Der Variablenname muss exakt dem entsprechen, was die Bridge liest
# (HOST_LABEL = os.environ.get("AGENTX_TELEMETRY_HOSTLABEL")).
AGENTX_TELEMETRY_HOSTLABEL=hetzner
